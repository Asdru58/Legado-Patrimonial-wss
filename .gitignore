# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
ingesta_lote_piloto2.log
ingesta_resumen_lote.log
excepciones_match_pendientes.log
excepciones_ocr_pendientes.log
excepciones_error_lote.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Binarios de sistema y archivos de instalación
*.msi
*.exe
*.dmg
*.pkg
*.deb
*.rpm

# Archivos comprimidos grandes (backups, dumps)
*.zip
*.tar.gz
*.rar
*.7z

# Artefactos locales de auditoria y documentos de trabajo
*.mp4
*.pdf
*.docx
*.sql
!supabase/migrations/*.sql
*.html
*.txt
!requirements.txt

# Proxy experimental / migracion futura Next.js 16
src/proxy.ts

# Informes Markdown locales en raiz del proyecto
/*.md

# Carpetas locales de ejecucion / respaldos
/Ejecucion Completada*/

# Reportes locales de auditoria del catalogo
/scripts/auditoria_catalogo/reportes/
